node_modules/
# Local Claude Code state (skills, settings.local.json) stays untracked; the
# SessionStart hook and the settings that register it are shared.
.claude/*
!.claude/settings.json
!.claude/hooks/
# Agent skills installed with `npx skills add` (e.g. replicate/skills) are
# local too: their files and lock stay out of the repo like .claude/skills.
.agents/
skills-lock.json
.env
.env.local
.dev.vars
.wrangler/
dist/
public/aura.bundle.js
public/aura.bundle.js.map
public/material.bundle.js
public/material.bundle.js.map
public/sw.js
# Bundled Transformers.js + ONNX Runtime — regenerated by `npm run build`
# (both the CI deploy workflow and `npm run dev` build fresh, so nothing
# depends on these being committed). Not tracked for a second reason: the
# minified bundle embeds a Hugging Face gist URL whose hex id collides with
# GitHub's Mistral-API-key secret-scanning pattern, which blocks the push —
# see the BROWSER engine PR for details.
public/assets/ml.worker.js
public/assets/ml.worker.js.map
public/ort/
# ONNX Runtime loader bundles the worker imports relative to itself — copied
# from node_modules by scripts/build-react.js on every build, like public/ort/.
public/assets/ort*.bundle.min.mjs
npm-debug.log*
.DS_Store
megalinter-reports/
