{
  "name": "aura",
  "version": "2.0.0",
  "description": "Aura — turn any phone camera into an automated visual monitor powered by any OpenAI-compatible vision model. Bring your own API key + model. Pure static PWA, no backend required.",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/refresh-pricing.js",
    "refresh:pricing": "node scripts/refresh-pricing.js",
    "build": "node scripts/build-react.js",
    "predev": "node scripts/gen-icons.js && npm run build",
    "dev": "npx serve public",
    "preview:local": "wrangler dev --local --port 8787",
    "preview:deploy": "wrangler deploy",
    "predeploy": "npm run build",
    "deploy": "npx gh-pages -d public -m \"deploy: $(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
    "test": "node --test",
    "lint": "npm run lint:css && npm run lint:dup && npm run lint:html",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:dup": "jscpd --config .jscpd.json --reporters console .",
    "lint:html": "djlint --lint --ignore H049 public/index.html public/probe.html"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ax-llm/ax": "^22.0.7",
    "@huggingface/transformers": "^4.3.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@sentry/browser": "^10.65.0",
    "@uidotdev/usehooks": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.1",
    "gh-pages": "^6.1.1",
    "jscpd": "^4.3.0",
    "serve": "^14.2.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.54.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.0",
    "fast-uri": "^3.1.6"
  },
  "license": "GPL-3.0"
}
